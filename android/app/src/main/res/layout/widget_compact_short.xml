<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_3"
    android:clipToOutline="true"
    android:outlineProvider="background">

    <ImageView
        android:id="@+id/compact_art_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_open_app"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_default_art" />

    <LinearLayout
        android:id="@+id/compact_metadata"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/compact_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/widget_nothing_playing"
                android:scaleType="fitStart" />
            <ImageView
                android:id="@+id/compact_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/widget_nothing_playing"
                android:scaleType="fitStart"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/compact_play_pause"
            style="@style/WidgetCompactPlayButton"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/widget_play_pause"
            android:src="@drawable/widget_ic_lucide_play" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/compact_controls"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp">

        <ImageView
            android:id="@+id/compact_progress"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="56dp"
            android:layout_marginEnd="56dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />
        <ImageButton
            android:id="@+id/compact_prev"
            style="@style/WidgetTransportButton"
            android:layout_gravity="start"
            android:padding="16dp"
            android:contentDescription="@string/widget_previous"
            android:src="@drawable/widget_ic_lucide_skip_back" />
        <ImageButton
            android:id="@+id/compact_next"
            style="@style/WidgetTransportButton"
            android:layout_gravity="end"
            android:padding="16dp"
            android:contentDescription="@string/widget_next"
            android:src="@drawable/widget_ic_lucide_skip_forward" />
    </FrameLayout>
</FrameLayout>
