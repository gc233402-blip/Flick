<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Measure a square from the actual host width, not estimated dp or album art. -->
    <ImageView
        android:id="@+id/compact_square_bounds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_compact_square_bounds"
        android:visibility="invisible" />

    <FrameLayout
        android:id="@+id/compact_square_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/compact_square_bounds"
        android:layout_alignBottom="@id/compact_square_bounds" />
</RelativeLayout>
