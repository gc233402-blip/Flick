<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_mini_background"
        android:clipToOutline="true"
        android:outlineProvider="background">

        <LinearLayout
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingEnd="4dp">

            <ImageView
                android:id="@+id/widget_thumbnail"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/widget_open_app"
                android:scaleType="fitXY"
                android:src="@drawable/widget_mini_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/widget_nothing_playing"
                    android:scaleType="fitStart" />
                <ImageView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/widget_nothing_playing"
                    android:scaleType="fitStart"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/widget_play_pause"
                style="@style/WidgetTransportButton"
                android:padding="14dp"
                android:contentDescription="@string/widget_play_pause"
                android:src="@drawable/widget_ic_lucide_play" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
